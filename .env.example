# WindLens environment variable template.
# Copy this file to .env and fill in values. Never commit .env.

# Backend
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
# Default decision cutoff hour (UTC) on D-1. Assumption — not an official Gridbricks rule.
DEFAULT_CUTOFF_HOUR=11
# CORS: comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend (Vite)
# Set this to your deployed backend URL in production
VITE_API_URL=http://localhost:8000
